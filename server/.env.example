# Copy to .env and fill in. NEVER commit .env.
LLM_PROVIDER=gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
# Optional NASA key for the rover-photo proxy (free at https://api.nasa.gov). Blank = DEMO_KEY.
NASA_API_KEY=G8your_nasa_api_key_here
# Optional: override model name, extra allowed web origins (comma separated), or turn off strict fact checking.
# LLM_MODEL=
# ALLOWED_ORIGINS=https://yourname.github.io
# STRICT_FACTS=1
